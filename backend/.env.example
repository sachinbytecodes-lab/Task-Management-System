# MongoDB Atlas connection string (or local mongodb://localhost:27017/pyramid)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pyramid

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the frontend runs — the API redirects here after Google login, and only allows CORS from here
FRONTEND_URL=http://localhost:3000

PORT=4000
